{
  "name": "controlslab",
  "version": "0.1.0",
  "private": true,
  "description": "Plateforme libre de formation en automatisme industriel (API/PLC, dépannage électrique) dans le navigateur.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev -w @controlslab/web",
    "build": "npm run build -w @controlslab/web",
    "preview": "npm run preview -w @controlslab/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -b && tsc -p apps/web",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "prettier": "^3.10.1",
    "typescript": "5.6",
    "typescript-eslint": "^8.72.2",
    "vitest": "^3.2.7"
  }
}
