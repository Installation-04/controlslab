# ControlsLab — environment file.
# Copy to ".env" (install.sh does this for you) and adjust. Never commit ".env".

# Host port for the web UI (the container always listens on 8080 inside).
# Reserved range for this project: 12000-12009. The web UI uses 12000.
WEB_PORT=12000

# Time zone for the container (logs).
TZ=America/Toronto
